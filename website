<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>DataNova Consulting — Accelerating Data. Empowering Decisions.</title>
<meta name="description" content="Enterprise Oracle modernization, ETL engineering, and cloud data platforms on Azure and AWS.">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=IBM+Plex+Sans:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500;600&display=swap" rel="stylesheet">
<style>
  :root{
    --ink:#08111d;
    --panel:#0e1a2c;
    --panel-2:#12203570;
    --line:#22344c;
    --text:#e8edf3;
    --muted:#8fa0b5;
    --teal:#2bd9c0;
    --teal-dim:#1d9a89;
    --amber:#f2a340;
    --radius:10px;
  }
  *{margin:0;padding:0;box-sizing:border-box;}
  html{scroll-behavior:smooth;}
  body{
    background:var(--ink);
    color:var(--text);
    font-family:'IBM Plex Sans', sans-serif;
    line-height:1.6;
    -webkit-font-smoothing:antialiased;
  }
  .mono{font-family:'IBM Plex Mono', monospace;}
  h1,h2,h3,h4{font-family:'Space Grotesk', sans-serif; font-weight:600; letter-spacing:-0.01em;}
  a{color:inherit; text-decoration:none;}
  img{max-width:100%; display:block;}
  .wrap{max-width:1180px; margin:0 auto; padding:0 28px;}
  section{padding:96px 0;}
  .eyebrow{
    font-family:'IBM Plex Mono', monospace;
    font-size:12.5px;
    letter-spacing:0.14em;
    text-transform:uppercase;
    color:var(--teal);
    display:inline-flex;
    align-items:center;
    gap:8px;
    margin-bottom:14px;
  }
  .eyebrow::before{content:"//"; color:var(--teal-dim);}
  h2.section-title{font-size:clamp(26px,3.4vw,38px); margin-bottom:14px;}
  .section-sub{color:var(--muted); max-width:560px; font-size:16px;}
  .section-head{margin-bottom:48px;}

  /* ---------- Header ---------- */
  header{
    position:sticky; top:0; z-index:100;
    background:rgba(8,17,29,0.82);
    backdrop-filter:blur(14px);
    border-bottom:1px solid var(--line);
  }
  .nav-inner{
    display:flex; align-items:center; justify-content:space-between;
    padding:16px 28px; max-width:1180px; margin:0 auto;
  }
  .logo{display:flex; align-items:center; gap:10px; font-family:'Space Grotesk',sans-serif; font-weight:700; font-size:19px;}
  .logo-mark{
    width:30px; height:30px; border-radius:7px;
    background:linear-gradient(135deg,var(--teal),var(--teal-dim));
    display:flex; align-items:center; justify-content:center;
    color:var(--ink); font-family:'IBM Plex Mono',monospace; font-weight:600; font-size:14px;
  }
  nav.links{display:flex; gap:30px; font-size:14.5px; color:var(--muted);}
  nav.links a{transition:color .15s;}
  nav.links a:hover{color:var(--text);}
  .nav-cta{
    display:inline-flex; align-items:center; gap:8px;
    background:var(--teal); color:#04231e; font-weight:600; font-size:14px;
    padding:10px 18px; border-radius:7px; transition:transform .15s, background .15s;
    white-space:nowrap;
  }
  .nav-cta:hover{background:#4fe6cf; transform:translateY(-1px);}
  .burger{display:none; background:none; border:1px solid var(--line); border-radius:6px; width:38px; height:38px; color:var(--text); font-size:18px; cursor:pointer;}

  /* ---------- Hero ---------- */
  .hero{padding:76px 0 60px;}
  .hero-grid{display:grid; grid-template-columns:1.05fr 0.95fr; gap:56px; align-items:center;}
  .hero h1{font-size:clamp(32px,4.3vw,52px); line-height:1.08; margin-bottom:22px;}
  .hero h1 .accent{color:var(--teal);}
  .hero p.lead{color:var(--muted); font-size:17.5px; max-width:520px; margin-bottom:32px;}
  .cta-row{display:flex; gap:14px; flex-wrap:wrap; margin-bottom:34px;}
  .btn-primary, .btn-secondary{
    padding:13px 22px; border-radius:8px; font-weight:600; font-size:15px;
    display:inline-flex; align-items:center; gap:8px; transition:all .15s;
  }
  .btn-primary{background:var(--teal); color:#04231e;}
  .btn-primary:hover{background:#4fe6cf; transform:translateY(-1px);}
  .btn-secondary{border:1px solid var(--line); color:var(--text);}
  .btn-secondary:hover{border-color:var(--teal); color:var(--teal);}
  .tag-row{display:flex; flex-wrap:wrap; gap:9px;}
  .tag{
    font-family:'IBM Plex Mono',monospace; font-size:12px; color:var(--teal);
    border:1px solid var(--teal-dim); background:#0f2a26; padding:6px 11px; border-radius:20px;
  }

  /* Signature element: query optimization panel */
  .signature-card{
    background:var(--panel); border:1px solid var(--line); border-radius:14px;
    padding:22px 22px 26px; box-shadow:0 30px 60px -30px rgba(0,0,0,0.6);
  }
  .sig-top{display:flex; justify-content:space-between; align-items:center; margin-bottom:18px;}
  .sig-dots{display:flex; gap:6px;}
  .sig-dots span{width:9px; height:9px; border-radius:50%; background:#2a3d55;}
  .sig-label{font-family:'IBM Plex Mono',monospace; font-size:11.5px; color:var(--muted);}
  .plan-row{display:flex; align-items:center; gap:12px; margin-bottom:16px; font-family:'IBM Plex Mono',monospace; font-size:13px;}
  .plan-row .plan-tag{width:78px; flex-shrink:0; color:var(--muted);}
  .track{position:relative; flex:1; height:10px; background:#132335; border-radius:5px; overflow:hidden;}
  .track-fill{position:absolute; left:0; top:0; bottom:0; border-radius:5px;}
  .track.before .track-fill{width:96%; background:linear-gradient(90deg,#7a3a12,var(--amber));}
  .track.after .track-fill{width:6%; background:linear-gradient(90deg,var(--teal-dim),var(--teal)); animation:scanpulse 2.6s ease-in-out infinite;}
  @keyframes scanpulse{0%,100%{filter:brightness(1);} 50%{filter:brightness(1.5);}}
  .plan-time{width:52px; text-align:right; flex-shrink:0; color:var(--text);}
  .sig-divider{height:1px; background:var(--line); margin:18px 0;}
  .sig-metrics{display:grid; grid-template-columns:1fr 1fr 1fr; gap:14px; text-align:center;}
  .sig-metrics div span.num{display:block; font-family:'IBM Plex Mono',monospace; font-size:20px; color:var(--teal); font-weight:600;}
  .sig-metrics div span.lbl{font-size:11px; color:var(--muted); text-transform:uppercase; letter-spacing:.06em;}

  /* ---------- Metrics strip ---------- */
  .metrics-strip{
    border-top:1px solid var(--line); border-bottom:1px solid var(--line);
    background:var(--panel);
  }
  .metrics-grid{display:grid; grid-template-columns:repeat(4,1fr); padding:44px 0;}
  .metric{text-align:center; border-right:1px solid var(--line);}
  .metric:last-child{border-right:none;}
  .metric .num{font-family:'Space Grotesk',sans-serif; font-size:clamp(24px,2.6vw,34px); font-weight:700; color:var(--teal);}
  .metric .lbl{color:var(--muted); font-size:13px; margin-top:4px;}

  /* ---------- Cards / grids ---------- */
  .grid-3{display:grid; grid-template-columns:repeat(3,1fr); gap:22px;}
  .grid-2{display:grid; grid-template-columns:repeat(2,1fr); gap:22px;}
  .card{
    background:var(--panel); border:1px solid var(--line); border-radius:var(--radius);
    padding:28px 26px; transition:border-color .2s, transform .2s;
  }
  .card:hover{border-color:var(--teal-dim); transform:translateY(-3px);}
  .card h3{font-size:18px; margin-bottom:10px;}
  .card p{color:var(--muted); font-size:14.5px;}
  .card ul{margin-top:14px; padding-left:0; list-style:none;}
  .card ul li{
    color:var(--muted); font-size:14px; padding:6px 0 6px 20px; position:relative;
    border-top:1px solid var(--line);
  }
  .card ul li:first-child{border-top:none;}
  .card ul li::before{content:"›"; position:absolute; left:0; color:var(--teal);}
  .card-icon{
    width:38px; height:38px; border-radius:8px; background:#0f2a26; color:var(--teal);
    display:flex; align-items:center; justify-content:center; margin-bottom:16px;
    font-family:'IBM Plex Mono',monospace; font-size:15px; font-weight:600;
  }

  /* ---------- Industries ---------- */
  .industry-strip{display:grid; grid-template-columns:repeat(6,1fr); gap:16px;}
  .industry{
    text-align:center; padding:26px 12px; border:1px solid var(--line); border-radius:var(--radius);
    background:var(--panel); font-size:14px; color:var(--muted); transition:border-color .2s, color .2s;
  }
  .industry:hover{border-color:var(--teal-dim); color:var(--text);}
  .industry .ic{font-size:26px; display:block; margin-bottom:10px;}

  /* ---------- Tech stack ---------- */
  .stack-wrap{display:flex; flex-wrap:wrap; gap:12px;}
  .pill{
    font-family:'IBM Plex Mono',monospace; font-size:13.5px; color:var(--text);
    border:1px solid var(--line); padding:9px 16px; border-radius:7px; background:var(--panel);
  }

  /* ---------- Process ---------- */
  .process-list{position:relative; padding-left:52px;}
  .process-list::before{
    content:""; position:absolute; left:19px; top:8px; bottom:8px; width:1px; background:var(--line);
  }
  .process-step{position:relative; padding-bottom:38px;}
  .process-step:last-child{padding-bottom:0;}
  .process-step .step-num{
    position:absolute; left:-52px; top:0; width:40px; height:40px; border-radius:50%;
    background:var(--panel); border:1px solid var(--teal-dim); color:var(--teal);
    display:flex; align-items:center; justify-content:center; font-family:'IBM Plex Mono',monospace; font-weight:600; font-size:14px;
  }
  .process-step h4{font-size:17px; margin-bottom:4px;}
  .process-step p{color:var(--muted); font-size:14.5px;}

  /* ---------- Testimonials ---------- */
  .quote-card{
    background:var(--panel); border:1px solid var(--line); border-radius:var(--radius); padding:28px;
  }
  .quote-card .mark{color:var(--teal-dim); font-family:'Space Grotesk',sans-serif; font-size:34px; line-height:1; display:block; margin-bottom:6px;}
  .quote-card p.q{font-size:15.5px; margin-bottom:18px; color:var(--text);}
  .quote-card .who{font-family:'IBM Plex Mono',monospace; font-size:12.5px; color:var(--muted); border-top:1px solid var(--line); padding-top:14px;}

  /* ---------- Pricing ---------- */
  .price-grid{display:grid; grid-template-columns:repeat(5,1fr); gap:18px;}
  .price-card{
    background:var(--panel); border:1px solid var(--line); border-radius:var(--radius);
    padding:26px 20px; text-align:left; display:flex; flex-direction:column; gap:14px;
  }
  .price-card h4{font-size:15.5px;}
  .price-card .amount{font-family:'IBM Plex Mono',monospace; color:var(--teal); font-size:19px; font-weight:600;}
  .price-card .desc{color:var(--muted); font-size:12.5px;}

  /* ---------- FAQ ---------- */
  .faq-item{border-bottom:1px solid var(--line);}
  .faq-q{
    width:100%; text-align:left; background:none; border:none; color:var(--text);
    padding:20px 0; font-size:16px; font-family:'Space Grotesk',sans-serif; font-weight:500;
    display:flex; justify-content:space-between; align-items:center; cursor:pointer;
  }
  .faq-q .icon{color:var(--teal); font-family:'IBM Plex Mono',monospace; transition:transform .2s;}
  .faq-item.open .faq-q .icon{transform:rotate(45deg);}
  .faq-a{max-height:0; overflow:hidden; transition:max-height .25s ease;}
  .faq-a p{color:var(--muted); padding-bottom:20px; font-size:14.5px; max-width:640px;}

  /* ---------- Contact ---------- */
  .contact-grid{display:grid; grid-template-columns:0.9fr 1.1fr; gap:50px;}
  .contact-info h2{font-size:clamp(26px,3vw,36px); margin-bottom:16px;}
  .contact-info p{color:var(--muted); margin-bottom:30px; max-width:420px;}
  .contact-row{display:flex; gap:12px; align-items:center; padding:14px 0; border-top:1px solid var(--line); font-size:14.5px;}
  .contact-row:first-of-type{border-top:none;}
  .contact-row .ic{color:var(--teal); font-family:'IBM Plex Mono',monospace;}
  .contact-form{background:var(--panel); border:1px solid var(--line); border-radius:var(--radius); padding:30px;}
  .contact-form label{display:block; font-size:12.5px; color:var(--muted); margin-bottom:6px; font-family:'IBM Plex Mono',monospace; text-transform:uppercase; letter-spacing:.06em;}
  .contact-form input, .contact-form textarea, .contact-form select{
    width:100%; background:#0b1626; border:1px solid var(--line); border-radius:7px; color:var(--text);
    padding:11px 13px; font-family:'IBM Plex Sans',sans-serif; font-size:14.5px; margin-bottom:18px;
  }
  .contact-form input:focus, .contact-form textarea:focus, .contact-form select:focus{outline:2px solid var(--teal-dim); border-color:transparent;}
  .contact-form button{width:100%; padding:13px; border:none; border-radius:8px; background:var(--teal); color:#04231e; font-weight:600; font-size:15px; cursor:pointer;}
  .contact-form button:hover{background:#4fe6cf;}

  /* ---------- Footer ---------- */
  footer{border-top:1px solid var(--line); padding:44px 0 34px;}
  .footer-grid{display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:20px;}
  .footer-links{display:flex; gap:22px; flex-wrap:wrap; font-size:13.5px; color:var(--muted);}
  .footer-links a:hover{color:var(--teal);}
  .footer-copy{color:#5c6b80; font-size:12.5px; margin-top:24px;}

  .reveal{opacity:0; transform:translateY(16px); transition:opacity .6s ease, transform .6s ease;}
  .reveal.in{opacity:1; transform:translateY(0);}

  @media (max-width: 920px){
    .hero-grid, .contact-grid{grid-template-columns:1fr;}
    .grid-3, .grid-2, .price-grid{grid-template-columns:1fr 1fr;}
    .metrics-grid{grid-template-columns:repeat(2,1fr);}
    .metric{border-right:none; border-bottom:1px solid var(--line); padding-bottom:20px;}
    .industry-strip{grid-template-columns:repeat(3,1fr);}
    nav.links{display:none;}
    .burger{display:block;}
  }
  @media (max-width: 600px){
    section{padding:64px 0;}
    .grid-3, .grid-2, .price-grid{grid-template-columns:1fr;}
    .industry-strip{grid-template-columns:repeat(2,1fr);}
  }
  @media (prefers-reduced-motion: reduce){
    *{animation:none !important; transition:none !important;}
    html{scroll-behavior:auto;}
  }
</style>
</head>
